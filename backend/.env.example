# Copie a .env y complete los valores. El archivo .env NO se sube a Git.

# Conexión a PostgreSQL
#   Local:  postgresql://USUARIO:CLAVE@localhost:5432/clave_scheduling
#   AWS:    postgresql://USUARIO:CLAVE@<endpoint-del-RDS>:5432/clave_scheduling
DATABASE_URL=

# true en AWS (el RDS exige SSL); false en local
DATABASE_SSL=false

# Secreto para firmar los JWT (una cadena larga y aleatoria)
JWT_SECRET=

# Orígenes permitidos por CORS (Angular local y, en la Aula 4, el S3 website)
FRONTEND_URL=http://localhost:4200

PORT=3000

# Contraseña inicial de los usuarios creados por el seed
SEED_PASSWORD=

# Solo para docker-compose local
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=clave_scheduling
